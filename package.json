{
  "name": "porthole",
  "version": "0.0.1",
  "private": true,
  "description": "A phone as a window onto a shared 3D world on Swarm",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/petfold/porthole"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "PORTHOLE_HTTPS=1 vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "check:types": "tsc --noEmit",
    "publish:swarm": "node scripts/publish-to-swarm.mjs",
    "make:world": "node scripts/make-world.mjs",
    "fetch:assets": "node scripts/fetch-assets.mjs",
    "prepare": "node scripts/fetch-assets.mjs",
    "test:headless": "node scripts/headless-run.mjs"
  },
  "dependencies": {
    "@ethersphere/bee-js": "^13.0.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
